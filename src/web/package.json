    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.11.1",
    "knip": "^6.29.0",
    "postcss": "^8.5",
    "postcss-load-config": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^7",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
