{
  "name": "investlogix-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write . && pnpm typecheck && knip",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "knip": "knip",
    "test": "vitest run",
    "ci": "biome ci .",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "cf-dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "latest",
    "lucide-react": "^1.37.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.1",
    "recharts": "3.10.1",
    "swr": "2.5.1",
    "tailwind-merge": "^3.6.0",
    "use-sync-external-store": "latest",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.12.0",
    "knip": "^6.33.0",
    "postcss": "^8.5",
    "postcss-load-config": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^7",
    "vite": "^8.1.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
