# infra/ で使う環境変数のひな型。
# 実体の .env は gitignore 対象（リポジトリの .gitignore で .env が無視される）。
#
# 使い方:
#   cp .env.example .env
#   # 値を編集
#   set -a; source .env; set +a   # cd した直後に毎回実行
#
# Terraform / OpenTofu は TF_VAR_xxx という名前の環境変数を variable として自動で読む。

TF_VAR_project_id="your-gcp-project-id"

# Cloud Build がビルドする最新イメージの URI。初回 import 時の値を入れる。
# 以降は Cloud Build の自動デプロイが Cloud Run の image を直接書き換える運用なので、
# OpenTofu は ignore_changes で無視する（この値は state 上の初期値としてのみ意味を持つ）。
TF_VAR_image_uri="asia-northeast1-docker.pkg.dev/your-gcp-project-id/cloud-run-source-deploy/investlogix/investlogix-api:<commit-sha>"

# Supabase 接続情報（Cloud Run Service / Jobs の env vars に注入される）
# 値は既存 Cloud Run Service の env から取得する:
#   gcloud run services describe investlogix-api \
#     --project="${TF_VAR_project_id}" --region="asia-northeast1" \
#     --format='value(spec.template.spec.containers[0].env)'
TF_VAR_db_user="<DB_USER の値>"
TF_VAR_db_host="<DB_HOST の値>"

# CORS_ORIGINS（HCL 側で jsonencode するので、ここでは JSON 配列形式で渡す）
TF_VAR_cors_origins='["https://example.com","http://localhost:5173"]'

# CD (GitHub Actions) 用。WIF の attribute_condition で repository を絞るため必須。
TF_VAR_github_repository="<github-owner>/<repo>"
