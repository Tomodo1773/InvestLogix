# Environment
ENVIRONMENT=development

# Database settings
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=investlogix
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Authentication settings
JWT_SECRET_KEY=your-secret-key  # 本番環境では強力な秘密鍵に変更してください
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS settings
CORS_ORIGINS=["http://localhost:3000"]  # フロントエンドのオリジンに合わせて設定してください

# Server settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
RELOAD=true  # 開発環境でのみtrueに設定してください