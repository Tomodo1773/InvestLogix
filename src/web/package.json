{
  "name": "investlogix-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write . && pnpm typecheck && knip",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "knip": "knip",
    "test": "vitest run",
    "ci": "biome ci .",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "cf-dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "latest",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.0",
    "recharts": "3.10.1",
    "swr": "2.4.2",
    "tailwind-merge": "^3.6.0",
    "use-sync-external-store": "latest",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@tailwindcss/postcss": "^4.3.3",
