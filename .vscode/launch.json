{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Python: FastAPI",
			"type": "debugpy",
			"request": "launch",
			"module": "uvicorn",
			"args": ["stock.app:app", "--reload"],
			"console": "integratedTerminal",
			"cwd": "${workspaceFolder}/src/api",
			"envFile": "${workspaceFolder}/.env",
			"env": {
				"PYTHONPATH": "${workspaceFolder}/src/api"
			}
		}
	]
}
